# Copie este arquivo para .env e preencha. NUNCA faça commit do .env.
# Gere cada senha com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use senhas DIFERENTES para o administrador e para a aplicação.
# DB_ADMIN_*: só para o container do PostgreSQL e scripts administrativos.
# DB_APP_*: usuário de privilégios limitados, é o que o backend usa.
DB_HOST=
DB_PORT=
DB_NAME=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_APP_USER=
DB_APP_PASSWORD=
DB_APP_ROLE=

SECRET_KEY=
TOTP_ENCRYPTION_KEY=
FLASK_DEBUG=false

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

APP_BASE_URL=http://localhost:5000

# Configurações de Segurança e Cookies (TLS/HTTPS)
SECURE_COOKIES=true