# Modelo de variáveis de ambiente para Produção na VPS (mentory.stack-n8n.cloud)
# Copie para .env.prod na VPS e preencha com as credenciais reais. NUNCA comite o .env.prod!
#
# Dica de geração de senhas e chaves seguras:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Banco de Dados (Container isolado do Mentory)
DB_HOST=mentory-postgres
DB_PORT=5432
DB_NAME=mentory
DB_ADMIN_USER=mentory_admin
DB_ADMIN_PASSWORD=
DB_APP_USER=mentory_app
DB_APP_PASSWORD=
DB_APP_ROLE=mentory_app_role

# Segurança da Aplicação
SECRET_KEY=
TOTP_ENCRYPTION_KEY=
FLASK_DEBUG=false

# Configurações de E-mail (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=
MAIL_PASSWORD=

# URL Base e Cookies Seguros
APP_BASE_URL=https://mentory.stack-n8n.cloud
SECURE_COOKIES=true
